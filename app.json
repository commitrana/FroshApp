{
  "expo": {
    "name": "Frosh",
    "slug": "FroshApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan the attendance QR code shown by your professor.",
        "NSLocationWhenInUseUsageDescription": "Used to verify you're in the classroom when marking attendance."
      },
      "bundleIdentifier": "froshtiet.in"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "froshtiet.in"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the attendance QR code shown by your professor."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to verify you're in the classroom when marking attendance."
        }
      ],
      "./plugins/withExpoGLSwift5"
    ],
    "extra": {
      "eas": {
        "projectId": "dab70f1f-7251-490f-bbaf-86c2f983297c"
      }
    }
  }
}
